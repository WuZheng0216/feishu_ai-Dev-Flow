API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=5173

# Mock is the default so the full demo works without an API key.
LLM_PROVIDER=mock

# Doubao / Volcengine Ark. Set LLM_PROVIDER=doubao to enable.
# The endpoint id is usually the ep-... value from Ark console.
DOUBAO_API_KEY=
DOUBAO_ENDPOINT_ID=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_TEMPERATURE=0.2
DOUBAO_MAX_TOKENS=1200
DOUBAO_TIMEOUT_MS=60000

# Optional Feishu integration placeholders.
FEISHU_WEBHOOK_URL=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
